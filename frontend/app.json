
{
  "expo": {
    "name": "Cuisine entre Voisins",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,

    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Prenez une photo de votre plat",
        "NSPhotoLibraryUsageDescription": "Ajoutez des photos de vos plats",
        "NSLocationWhenInUseUsageDescription": "Trouvez les plats près de chez vous"
      }
    },

    "android": {
      "package": "com.cuisineentrevoisins.mobile",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ]
    },

    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",

      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF"
        }
      ],

      [
        "expo-image-picker",
        {
          "photosPermission": "Ajoutez des photos de vos plats délicieux",
          "cameraPermission": "Prenez une photo de votre plat"
        }
      ],

      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Trouvez les plats près de chez vous"
        }
      ],

      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#C75B3D"
        }
      ],

      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ],

    "experiments": {
      "typedRoutes": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "e360402c-a23a-4a39-a6fc-03cd071a03dd"
      }
    }
  }
}
